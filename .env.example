# npm start and npm run setup:admin load .env when present.
PORT=3153
SCAN_INTERVAL_MS=15000
AUTH_DB_PATH=data/cloudsentinel.sqlite
AUTH_SESSION_TTL_SECONDS=28800

# Enable the Vite proxy only while developing. Use the same port in your PORT environment variable when launching Vite.
# CLIENT_DEV_ORIGIN=http://127.0.0.1:5173

# Optional loopback services.
# FLOCI_LAB_ENABLED=0
# FLOCI_ENDPOINT=http://127.0.0.1:4566
# CLOUD_SOURCES_FILE=data/cloud-sources.json
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b

# Optional Google OAuth Web application. Open CloudSentinel using exactly this redirect origin.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3153/api/auth/google/callback

# Optional HTTPS LAN proxy. scripts/start-lan.ps1 supplies these at runtime.
# LAN_PROXY=0
# LAN_HTTPS_ORIGIN=https://172.20.10.2
# LAN_PROXY_TOKEN=  # 32 random bytes as lowercase hex, keep out of version control
# Optional Google OAuth only for an eligible registered HTTPS DNS domain.
# LAN_GOOGLE_CLIENT_ID=
# LAN_GOOGLE_CLIENT_SECRET=
# LAN_GOOGLE_REDIRECT_URI=https://your-owned-domain.example/api/auth/google/callback
