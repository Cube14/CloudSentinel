{
  "name": "cloudsentinel",
  "version": "1.0.0",
  "private": true,
  "description": "Local multi-cloud security monitoring workspace",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "build": "npm run build --workspace cloudsentinel-client",
    "dev:client": "npm run dev --workspace cloudsentinel-client",
    "setup:admin": "node --env-file-if-exists=.env server/setup-admin.js",
    "test": "node --test",
    "benchmark": "node tests/benchmark.js",
    "test:floci": "node tests/floci-smoke.js",
    "demo:preflight": "node --env-file-if-exists=.env scripts/demo-preflight.js",
    "lab:ssh": "node --env-file-if-exists=.env scripts/floci-ssh-demo.js",
    "lab:s3": "node --env-file-if-exists=.env scripts/floci-s3-lab.js",
    "demo:floci": "node tests/floci-demo.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0",
    "@aws-sdk/credential-provider-node": "^3.972.98",
    "openid-client": "^6.8.0"
  }
}
